# Copy to .env (never commit it) and fill in only the keys you need.
# Every script loads the repo-root .env through python-dotenv.

# --- LLM providers ------------------------------------------------------------
OPENAI_API_KEY=            # GPT generator and the automatic CARS annotator
ANTHROPIC_API_KEY=         # Claude generator
GEMINI_API_KEY=            # Gemini (preliminary annotator comparison only)

# Open-weight models behind an OpenAI-compatible endpoint (local vLLM or hosted)
OPENAI_COMPAT_BASE_URL=    # e.g. http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=     # any non-empty string for a local vLLM server

# Optional: keep several key sets in one file. With LLM_KEY_SUFFIX=LAB (or
# --key-suffix LAB) the clients read OPENAI_API_KEY_LAB first and fall back to
# OPENAI_API_KEY.
# LLM_KEY_SUFFIX=

# --- reference enrichment (data_processing/) ----------------------------------
# ELSEVIER_API_KEY=        # optional, improves abstract coverage

# --- human-study hosting (discrimination_experiment/) -------------------------
# ARGILLA_API_URL=
# ARGILLA_API_KEY=
# ANNOTATOR_PASSWORD=
# HF_TOKEN=                # build_static_ui.py --push
